/* Overall tab */
QWidget#ImportTab {
    background-color: #202124;
    color: #e8eaed;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* Main import button */
QPushButton#SelectVideoButton {
    background-color: #3b82f6;
    color: white;
    font-size: 24pt;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 12px;
    margin-left: 50px;
    margin-right: 50px;
    margin-top: 40px;
}

QPushButton#SelectVideoButton:hover {
    background-color: #2563eb;
}

QPushButton#SelectVideoButton:pressed {
    background-color: #1d4ed8;
}

/* Information labels */
QLabel#VideoInfo,
QLabel#AudioInfo {
    background-color: #303238;
    border-radius: 6px;
    padding: 12px;
    padding-top: 14px;
    padding-left: 16px;
    font-size: 18pt;
}

QLabel#VideoTitle,
QLabel#AudioTitle {
    margin-bottom: 5px;
    font-size: 22pt;
    font-weight: 900;
}

QLabel#Response {
    margin-top: 10px;
    margin-left: 20px;
    margin-right: 20px;
    margin-bottom: 0px;
    font-size: 14pt;
}

QLabel[status="success"] {
    color: #ff2ed14a;
}

QLabel[status="error"] {
    color: #ec4141
}